# Pick ONE backend.

# Option A (recommended for you): SerpAPI — one key, no daily cap.
#   Get it at https://serpapi.com/manage-api-key
SERPAPI_KEY=your-serpapi-key-here

# Option B: Google Custom Search — free 100 queries/day, needs two values.
#   GOOGLE_CX     -> https://programmablesearchengine.google.com/  (Search engine ID)
#   GOOGLE_API_KEY-> https://console.cloud.google.com/apis/credentials  (enable "Custom Search API")
# GOOGLE_API_KEY=your-api-key-here
# GOOGLE_CX=your-search-engine-id-here

# If SERPAPI_KEY is set it is used; otherwise the Google keys are used.
